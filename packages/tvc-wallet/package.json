{
  "name": "@zolana/tvc-wallet",
  "version": "0.0.0",
  "description": "Pre-production TVC client for attested Zolana private wallets. Not for production funds.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/check-production-boundary.mjs",
    "check:production-boundary": "node scripts/check-production-boundary.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.1",
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "@peculiar/x509": "1.12.3",
    "@turnkey/crypto": "2.11.3",
    "@turnkey/sdk-types": "1.5.1"
  },
  "peerDependencies": {
    "@heliuslabs/zolana": ">=0.1.0",
    "@solana/kit": "^7.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@heliuslabs/zolana": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heliuslabs/zolana": "github:helius-labs/zolana#93ebf405a99b6fa4af0c0b938a2cfb357c40ac4d&path:sdk-libs/ts",
    "@solana/kit": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
