# The build context is the repository root (`just image-privacy-wallet`). The
# image builds only the Cargo workspace; the TypeScript workspace and prose stay
# out so unrelated edits do not bust the build cache.
**/.git
**/.DS_Store
**/.env
**/.env.*
**/operator.json
**/target
**/node_modules
**/dist
.github
packages
examples
*.md
package.json
pnpm-lock.yaml
pnpm-workspace.yaml
tsconfig.json
eslint.config.js
