# `just headless-e2e` supplies all of these for its fresh localnet (default
# port offset 200). Set them only to run `pnpm e2e:headless:local` against a
# localnet and testkit you started yourself.
TVC_ENDPOINT=http://127.0.0.1:44020
TVC_SOLANA_RPC_URL=http://127.0.0.1:9099
TVC_INDEXER_URL=http://127.0.0.1:8984
TVC_PROVER_URL=http://127.0.0.1:3201

# Disposable local test material only.
TVC_SOLANA_KEYPAIR_PATH=/path/to/disposable-solana-keypair.json
TVC_IDENTITY_PATH=/path/to/local-identity.json

# From `scripts/start-localnet.sh` (`zolana dev pool test-mint`).
TVC_E2E_SPL_MINT=
TVC_E2E_SPL_ASSET_ID=
TVC_E2E_SPL_TOKEN_ACCOUNT=

TVC_E2E_DEPOSIT_LAMPORTS=20000000
TVC_E2E_SPL_AMOUNT=200000
TVC_E2E_SYNC_TIMEOUT_MS=180000
