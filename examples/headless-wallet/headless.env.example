# Optional overrides. `just headless-e2e` supplies these automatically for its
# fresh Zolana localnet (default port offset 200).
TVC_ENDPOINT=http://127.0.0.1:44020
# `just headless-e2e` generates both in a temporary directory. Uncomment only
# when deliberately reusing disposable local test material.
# TVC_SOLANA_KEYPAIR_PATH=/path/to/disposable-solana-keypair.json
# TVC_IDENTITY_PATH=/path/to/local-identity.json

TVC_SOLANA_RPC_URL=http://127.0.0.1:9099
TVC_INDEXER_URL=http://127.0.0.1:8984
TVC_PROVER_URL=http://127.0.0.1:3201
TVC_ALLOW_INSECURE_HTTP=1

TVC_E2E_DEPOSIT_LAMPORTS=20000000
TVC_E2E_TRANSFER_LAMPORTS=20000000
TVC_E2E_SPL_AMOUNT=200000
TVC_E2E_RING_BRIDGE_LAMPORTS=30000000
TVC_E2E_MERGE_INPUT_LAMPORTS=2000000
TVC_E2E_FEE_RESERVE_LAMPORTS=20000000

# The local fixture supplies the SPL mint/account/asset id and two fresh ring
# program ids. They intentionally have no reusable values in this file.
