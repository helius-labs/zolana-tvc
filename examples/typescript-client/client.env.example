# Helius devnet RPC key.
API_KEY=YOUR_KEY

# Optional overrides. Omit them to use Helius RPC, the devnet indexer, and the
# devnet prover. The client requests custom-ring base and policy proofs there;
# the enclave requests the shielded-pool proof from the same origin.
# ZOLANA_ENDPOINT=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# ZOLANA_INDEXER_URL=https://d2xah7tnhdhcom.cloudfront.net
# ZOLANA_PROVER_URL=https://d21ni15goiip6l.cloudfront.net

# TVC deployment. The operator publishes the endpoint and the trust material.
TVC_ENDPOINT=https://tvc.example.com
TVC_TRUST_PATH=../../apps/privacy-wallet/deploy/privacy-wallet.trust.json

# The Boot Proof: a server the operator runs returns it to any client. A client
# whose Turnkey API key is a user of the TVC organization reads it directly
# instead; set the organization and leave the URL empty.
TVC_BOOT_PROOF_URL=https://your-server.example.com/api/tvc/boot-proof
# TVC_ORGANIZATION_ID=

# SPL example only: a mint registered with the pool, its asset id, and the
# wallet's token account the deposit leaves from.
# SPL_MINT=
# SPL_ASSET_ID=
# SPL_TOKEN_ACCOUNT=
# SPL_AMOUNT=200000

# Ring example only: a custom ring program registered with the pool.
# RING_PROGRAM_ID=

# Files this example writes and reads. Keep them out of version control.
TVC_CLIENT_KEY_PATH=./tvc-client-key.json
TVC_DESCRIPTOR_PATH=./tvc-wallet-descriptor.json
TVC_WALLET_PATH=./tvc-wallet.json

# Turnkey API key of a user who may sign with the wallet in the descriptor.
# setup() configures the enclave's grant and automatically approves only the
# exact bootstrap message during an active bootstrap call. Grant configuration
# needs a root user in this development example. Keep the credential outside
# the TVC deployment and browser code. Either the key pair or
# a Turnkey API key file ({"public_key": hex, "private_key": hex}).
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# TURNKEY_API_KEY_PATH=/path/to/api_key.json

# Optional operator enrollment helper: the organization and the Solana wallet account to prepare.
# Leave the address empty to have enrollment create a new Solana wallet in the
# organization; set it to the printed address afterwards.
TURNKEY_ORGANIZATION_ID=
TURNKEY_WALLET_ADDRESS=

# Local run instead of a deployment: `just headless-e2e` sets all of these for
# its fresh localnet. The testkit stands in for the enclave and this
# keypair for the Turnkey wallet. Disposable test material only.
# TVC_LOCAL_TESTKIT_ENDPOINT=http://127.0.0.1:44020
# TVC_SOLANA_KEYPAIR_PATH=/path/to/disposable-solana-keypair.json
# ZOLANA_ENDPOINT=http://127.0.0.1:9099
# ZOLANA_INDEXER_URL=http://127.0.0.1:8984
# ZOLANA_PROVER_URL=http://127.0.0.1:3201
